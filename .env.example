# ============================================================
# Lead Intelligence Platform — environment template
# Copy to .env and fill real values. NEVER commit .env
# ============================================================

# --- App ---
APP_NAME="Lead Intelligence Platform"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORRELATION_ID_HEADER=X-Request-ID

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow_dev_pw
POSTGRES_DB=leadflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg2://leadflow:leadflow_dev_pw@localhost:5435/leadflow

# --- Auth / JWT ---
JWT_SECRET=change-me-in-real-deploy-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Scoring / Business rules (configurable overrides) ---
SCORE_VERSION=v1
SCORE_HOT_THRESHOLD=80
SCORE_WARM_THRESHOLD=60
SCORE_NURTURE_THRESHOLD=40

# --- Data generator ---
SYNTHETIC_SEED=20261022

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8002
BACKEND_PORT=8002
